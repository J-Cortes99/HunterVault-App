# ─────────────────────────────────────────────────────────────
# HunterVault · variables de entorno para docker-compose
# Copia este archivo a `.env` y rellena los valores reales.
# El `.env` NUNCA se sube a git (está en .gitignore).
# ─────────────────────────────────────────────────────────────

# Postgres
POSTGRES_DB=huntervault
POSTGRES_USER=huntervault
POSTGRES_PASSWORD=cambia-esto-por-algo-largo-y-aleatorio

# JWT — usa una cadena larga (>= 64 caracteres) y aleatoria.
# Genera una con:  openssl rand -base64 64
JWT_TOKEN=pega-aqui-tu-token-jwt-largo-y-aleatorio
JWT_ISSUER=HunterVaultApi
JWT_AUDIENCE=HunterVaultFrontend

# IGDB (Twitch OAuth)
IGDB_CLIENT_ID=tu-twitch-client-id
IGDB_CLIENT_SECRET=tu-twitch-client-secret

# SMTP (Gmail recomendado con app password)
SMTP_EMAIL=tu-cuenta@gmail.com
SMTP_PASSWORD=tu-app-password-de-gmail
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_FROM_NAME=HunterVault

# Dominio para Caddy (HTTPS automático con Let's Encrypt)
# Ej.: huntervault.duckdns.org  o  api.tudominio.com
DOMAIN=huntervault.duckdns.org

# Dominio de AniMatch (la app vecina, ~/animatch en la VM). Caddy le hace
# de HTTPS y proxy igual que a la API. Vacío = sitio deshabilitado.
ANIMATCH_DOMAIN=animatch.duckdns.org
